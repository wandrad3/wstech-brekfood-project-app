{
  "info": {
    "_postman_id": "bf000001-brek-f00d-api1-000000000001",
    "name": "BrekFood API — Epic 1 (Identity & Auth)",
    "description": "Manual test collection for the BrekFood platform.\n\n**Base URL** is controlled by the `{{base_url}}` variable (default: `http://localhost:8080`).\n\nThe **happy-path register and login** requests automatically save the JWT token to the `jwt_token` collection variable, which is used as Bearer auth by all protected-endpoint requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string",
      "description": "Change to your deployed host when testing non-local environments."
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string",
      "description": "Populated automatically by the register / login happy-path tests."
    },
    {
      "key": "registered_email",
      "value": "",
      "type": "string",
      "description": "Populated automatically after a successful register request."
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "🔓 Auth — Register",
      "description": "Public endpoint: POST /api/v1/auth/register\n\nAccepts: { email, password (min 8), name (max 100), role }\nReturns: 201 + { data: AuthResponse }",
      "item": [
        {
          "name": "[201] Register as Customer (happy path)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('response has data wrapper', () => pm.expect(json).to.have.property('data'));",
                  "pm.test('data has token', () => pm.expect(json.data.token).to.be.a('string').and.not.empty);",
                  "pm.test('data has userId', () => pm.expect(json.data.userId).to.match(/^[0-9a-f-]{36}$/i));",
                  "pm.test('data has email', () => pm.expect(json.data.email).to.eql(pm.variables.get('_reg_email')));",
                  "pm.test('data has name', () => pm.expect(json.data.name).to.be.a('string').and.not.empty);",
                  "pm.test('data has roleDisplayName', () => pm.expect(json.data.roleDisplayName).to.eql('Customer'));",
                  "pm.test('data has expiresAt', () => pm.expect(json.data.expiresAt).to.be.a('string').and.not.empty);",
                  "",
                  "// Persist token for subsequent requests",
                  "pm.collectionVariables.set('jwt_token', json.data.token);",
                  "pm.collectionVariables.set('registered_email', json.data.email);",
                  "console.log('✅ JWT saved:', json.data.token.substring(0, 30) + '...');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Use a timestamp to avoid duplicate-email conflicts on repeated runs",
                  "const ts = Date.now();",
                  "pm.variables.set('_reg_email', `customer_${ts}@brekfood.com`);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{_reg_email}}\",\n  \"password\": \"Passw0rd!\",\n  \"name\": \"Alice Customer\",\n  \"role\": \"CUSTOMER\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "Registers a new CUSTOMER. Saves the JWT to `jwt_token` for use in protected-endpoint tests."
          }
        },
        {
          "name": "[201] Register as Restaurant Owner",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('roleDisplayName is Restaurant Owner', () =>",
                  "  pm.expect(pm.response.json().data.roleDisplayName).to.eql('Restaurant Owner'));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": ["pm.variables.set('_reg_email', `owner_${Date.now()}@brekfood.com`);"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
