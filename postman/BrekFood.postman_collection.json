                  "  pm.expect(pm.response.json().error).to.eql('INVALID_CREDENTIALS'));",
                  "pm.test('WWW-Authenticate header is present', () =>",
                  "  pm.expect(pm.response.headers.get('WWW-Authenticate')).to.include('Bearer'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
