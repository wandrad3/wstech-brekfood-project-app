    {
      "name": "🔓 Auth — Login",
      "description": "Public endpoint: POST /api/v1/auth/login\n\nAccepts: { email, password }\nReturns: 200 + { data: AuthResponse }",
      "item": [
        {
          "name": "[200] Login — valid credentials (happy path)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Make sure you have already registered the user below.",
                  "// Tip: run '🔓 Auth — Register > [201] Register as Customer' first."
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('response has data wrapper', () => pm.expect(json).to.have.property('data'));",
                  "pm.test('data has token', () => pm.expect(json.data.token).to.be.a('string').and.not.empty);",
                  "pm.test('data has userId', () => pm.expect(json.data.userId).to.match(/^[0-9a-f-]{36}$/i));",
                  "pm.test('data has email', () => pm.expect(json.data.email).to.be.a('string').and.not.empty);",
                  "pm.test('data has expiresAt', () => pm.expect(json.data.expiresAt).to.be.a('string').and.not.empty);",
                  "",
                  "// Refresh the stored token",
                  "pm.collectionVariables.set('jwt_token', json.data.token);",
                  "pm.collectionVariables.set('registered_email', json.data.email);",
                  "console.log('✅ JWT refreshed:', json.data.token.substring(0, 30) + '...');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registered_email}}\",\n  \"password\": \"Passw0rd!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Uses `{{registered_email}}` saved by the register happy-path request.\n\nRefreshes `jwt_token` collection variable on success."
          }
        },
        {
          "name": "[401] Login — wrong password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));",
