# ======================================================
# BrekFood — Environment Variables Reference
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ======================================================
# --- APPLICATION ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# --- DATABASE ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=brekfood
DB_USER=brekfood
DB_PASSWORD=change_me_in_production
# --- CONNECTION POOL ---
DB_POOL_MAX=10
DB_POOL_MIN=2
# --- SECURITY / JWT ---
# Must be at least 32 characters (256-bit key).
# Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_a_strong_random_secret_at_least_256_bits_long
JWT_EXPIRATION_MS=86400000
# --- CORS ---
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000
# --- POSTGRES DOCKER (used only by docker-compose) ---
POSTGRES_DB=brekfood
POSTGRES_USER=brekfood
POSTGRES_PASSWORD=change_me_in_production
